# .env.example — copiar a .env. Todos los valores son ejemplos no secretos.
# En producción, el validador exige la sección OBLIGATORIA y rechaza fuentes legacy.

# -----------------------------------------------------------------------------
# OBLIGATORIAS EN PRODUCCIÓN
# -----------------------------------------------------------------------------
NODE_ENV=production
AUTH_ENABLED=true
SESSION_SECRET=<generar-un-secreto-aleatorio-de-al-menos-32-caracteres>
PUBLIC_APP_URL=https://app.example.invalid
DATA_SOURCE=postgres
CRM_SOURCE=postgres
POSTGRES_ENABLED=true

# Elegir DATABASE_URL o el bloque PG*. No completar ambos salvo necesidad expresa.
DATABASE_URL=
PGHOST=<postgres-host>
PGPORT=5432
PGDATABASE=<postgres-database>
PGUSER=<postgres-user>
PGPASSWORD=<postgres-password>
PGSSL=true

# Rol/login administrativo independiente (migraciones y jobs controlados).
# Debe poder asumir miclub_admin; nunca reutilizar estas credenciales en la API.
ADMIN_DATABASE_URL=
PGADMINHOST=<postgres-admin-host>
PGADMINPORT=5432
PGADMINDATABASE=<postgres-database>
PGADMINUSER=<postgres-admin-user>
PGADMINPASSWORD=<postgres-admin-password>
PGADMINSSL=true

# -----------------------------------------------------------------------------
# OPCIONALES / AJUSTES DE RUNTIME
# -----------------------------------------------------------------------------
PORT=4000
VITE_API_URL=
PUBLIC_REGISTRATION_ENABLED=false
CORS_ORIGINS=
JSON_BODY_LIMIT=1mb
RATE_LIMIT_STORE=postgres
DEBUG_ENDPOINTS_ENABLED=false
DEBUG_DASHBOARD_RECONCILIATION=false

# -----------------------------------------------------------------------------
# TEMPORALES — SOLO DURANTE UNA IMPORTACIÓN O TAREA OPERATIVA CONTROLADA
# Mantener los flags en false fuera de la ventana y nunca versionar secretos.
# -----------------------------------------------------------------------------
IMPORT_ENDPOINTS_ENABLED=false
IMPORT_OPERATOR_USER=
GOOGLE_SHEETS_IMPORT_ENABLED=false
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=<google-sheet-id>
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account-email>
GOOGLE_PRIVATE_KEY=<service-account-private-key-con-saltos-n-escapados>
GOOGLE_SHEETS_IMPORT_CLUB_ID=<club-uuid>
GOOGLE_SHEETS_IMPORT_USER_ID=<user-uuid>
GOOGLE_SHEETS_IMPORT_PERSON_ID=<person-uuid>
GOOGLE_SHEETS_IMPORT_MEMBERSHIP_ID=<membership-uuid>
GOOGLE_SHEETS_MISSING_ENROLLMENT_STRATEGY=warn
GOOGLE_SHEETS_TIMEOUT_MS=45000

GOOGLE_SHEETS_FITNESS_RANGE=FITNESS!AB20:BA1500
GOOGLE_SHEETS_SALON_RANGE=SALON!AB34:BB1500
GOOGLE_SHEETS_AULA_RANGE=AULA!AB34:BB1500
GOOGLE_SHEETS_FITNESS_MOVEMENTS_RANGE=FITNESS!B20:Y800
GOOGLE_SHEETS_SALON_MOVEMENTS_RANGE=SALON!B34:Y800
GOOGLE_SHEETS_AULA_MOVEMENTS_RANGE=AULA!B34:Y800
GOOGLE_SHEETS_LOCAL_1_MOVEMENTS_HEADER_RANGE='LOCAL 1'!B9:Y9
GOOGLE_SHEETS_LOCAL_1_MOVEMENTS_RANGE='LOCAL 1'!B10:Y3000
GOOGLE_SHEETS_ADMIN_MOVEMENTS_HEADER_RANGE=ADMINISTRACIÓN!B12:AB12
GOOGLE_SHEETS_ADMIN_MOVEMENTS_RANGE=ADMINISTRACIÓN!B13:AB3000
GOOGLE_SHEETS_ADMIN_BALANCES_RANGE=ADMINISTRACIÓN!AD12:AG14

BOOTSTRAP_DIRECTOR_ENABLED=false
BOOTSTRAP_DIRECTOR_PASSWORD=<definir-solo-en-el-proceso-bootstrap>
AUTH_NEW_PASSWORD=<definir-solo-al-rotar-una-clave>
CLUB_ID=<club-uuid-para-scripts-de-auditoria>

# -----------------------------------------------------------------------------
# LEGACY — NO USAR EN DESPLIEGUES NUEVOS
# Conservadas únicamente para migración/pruebas de compatibilidad.
# -----------------------------------------------------------------------------
SQLITE_DB_PATH=apps/api/data/miclub.sqlite

# STAGING: estos tres valores deben permanecer false. Los adaptadores se conservan
# solo hasta documentar comparación de snapshot y E2E XLSX exitoso.
# IMPORT_ENDPOINTS_ENABLED=false
# GOOGLE_SHEETS_IMPORT_ENABLED=false
# GOOGLE_SHEETS_ENABLED=false
