# .env.example — copiar a .env. Todos los valores son ejemplos no secretos.
# En producción, el validador exige la sección OBLIGATORIA y rechaza fuentes legacy.

# -----------------------------------------------------------------------------
# OBLIGATORIAS EN PRODUCCIÓN
# -----------------------------------------------------------------------------
NODE_ENV=production
AUTH_ENABLED=true
SESSION_SECRET=<generar-un-secreto-aleatorio-de-al-menos-32-caracteres>
PUBLIC_APP_URL=https://app.example.invalid
DATA_SOURCE=postgres
CRM_SOURCE=postgres
POSTGRES_ENABLED=true

# Elegir DATABASE_URL o el bloque PG*. No completar ambos salvo necesidad expresa.
DATABASE_URL=
PGHOST=<postgres-host>
PGPORT=5432
PGDATABASE=<postgres-database>
PGUSER=<postgres-user>
PGPASSWORD=<postgres-password>
PGSSL=true

# Login administrativo independiente (migraciones y jobs controlados). Completar
# ADMIN_DATABASE_URL O el bloque PGADMIN*, no ambos. Los valores los entrega el
# proveedor PostgreSQL/DBA; ver docs/runtime-rls-rollout.md.
# Debe poder asumir miclub_admin; nunca reutilizar estas credenciales en la API.
ADMIN_DATABASE_URL=
PGADMINHOST=<postgres-admin-host>
PGADMINPORT=5432
PGADMINDATABASE=<postgres-database>
PGADMINUSER=<postgres-admin-user>
PGADMINPASSWORD=<postgres-admin-password>
PGADMINSSL=true
# Opcional: rol propietario que el login admin debe asumir para ejecutar DDL.
# En instalaciones existentes suele ser el antiguo usuario de DATABASE_URL.
PGADMINROLE=

# -----------------------------------------------------------------------------
# OPCIONALES / AJUSTES DE RUNTIME
# -----------------------------------------------------------------------------
PORT=4000
VITE_API_URL=
# Valor seguro para `npm run start`/producción: disabled sólo permite FREE; live
# deja los pagos pendientes hasta que una futura pasarela confirme el pago.
# Para desarrollo con `npm run dev` puede cambiarse temporalmente a sandbox.
BILLING_MODE=disabled
# Sólo para desplegar sandbox bajo NODE_ENV=production en un staging autorizado.
# No basta con cambiar DEPLOYMENT_ENV: la autorización debe ser aleatoria,
# secreta y tener al menos 32 caracteres.
DEPLOYMENT_ENV=local
BILLING_SANDBOX_STAGING_AUTHORIZATION=
# Perfil de despliegue FIRST_E2E: habilitar sólo durante este primer E2E.
# Todo otro entorno debe fijar explícitamente false, salvo una ventana de alta
# pública aprobada según docs/deployment-runbook.md.
PUBLIC_REGISTRATION_ENABLED=true
CORS_ORIGINS=
JSON_BODY_LIMIT=1mb
RATE_LIMIT_STORE=postgres
DEBUG_ENDPOINTS_ENABLED=false
DEBUG_DASHBOARD_RECONCILIATION=false

# Fuentes oficiales por par. Todas persisten unidades de moneda cotizada por USD.
# BCRA A3500 publica ARS/USD; BCB SGS 1 publica BRL/USD; BCE publica USD/EUR y
# el adaptador invierte esa última observación. Ningún endpoint requiere token.
EXCHANGE_RATE_BCRA_URL=https://api.bcra.gob.ar/estadisticas/v4.0/Monetarias
EXCHANGE_RATE_BCRA_VARIABLE_ID=5
EXCHANGE_RATE_BCRA_TIMEOUT_MS=5000
EXCHANGE_RATE_BCRA_RETRIES=3
EXCHANGE_RATE_BCRA_LOOKBACK_DAYS=7
EXCHANGE_RATE_BCB_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.1/dados
EXCHANGE_RATE_BCB_TIMEOUT_MS=5000
EXCHANGE_RATE_BCB_RETRIES=3
EXCHANGE_RATE_BCB_LOOKBACK_DAYS=7
EXCHANGE_RATE_ECB_URL=https://data-api.ecb.europa.eu/service/data/EXR/D.USD.EUR.SP00.A
EXCHANGE_RATE_ECB_TIMEOUT_MS=5000
EXCHANGE_RATE_ECB_RETRIES=3
EXCHANGE_RATE_ECB_LOOKBACK_DAYS=7
EXCHANGE_RATE_SYNC_PAIRS=USD/ARS,USD/BRL,USD/EUR
EXCHANGE_RATE_MAX_AGE_DAYS=4
EXCHANGE_RATE_PIVOT_CURRENCY=USD

# -----------------------------------------------------------------------------
# TEMPORALES — SOLO DURANTE UNA IMPORTACIÓN O TAREA OPERATIVA CONTROLADA
# -----------------------------------------------------------------------------
IMPORT_ENDPOINTS_ENABLED=false
IMPORT_OPERATOR_USER=

BOOTSTRAP_DIRECTOR_ENABLED=false
BOOTSTRAP_DIRECTOR_PASSWORD=<definir-solo-en-el-proceso-bootstrap>
AUTH_NEW_PASSWORD=<definir-solo-al-rotar-una-clave>
CLUB_ID=<club-uuid-para-scripts-de-auditoria>

# -----------------------------------------------------------------------------
# LEGACY — NO USAR EN DESPLIEGUES NUEVOS
# Conservadas únicamente para migración/pruebas de compatibilidad.
# -----------------------------------------------------------------------------
SQLITE_DB_PATH=apps/api/data/miclub.sqlite

# STAGING: el endpoint XLSX debe permanecer deshabilitado fuera de una ventana
# controlada de importación.
# IMPORT_ENDPOINTS_ENABLED=false
