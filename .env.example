# .env.example — copiar a .env. Todos los valores son ejemplos no secretos.
# En producción, el validador exige la sección OBLIGATORIA y rechaza fuentes legacy.

# -----------------------------------------------------------------------------
# OBLIGATORIAS EN PRODUCCIÓN
# -----------------------------------------------------------------------------
NODE_ENV=production
AUTH_ENABLED=true
SESSION_SECRET=<generar-un-secreto-aleatorio-de-al-menos-32-caracteres>
PUBLIC_APP_URL=https://app.example.invalid
DATA_SOURCE=postgres
CRM_SOURCE=postgres
POSTGRES_ENABLED=true

# Elegir DATABASE_URL o el bloque PG*. No completar ambos salvo necesidad expresa.
DATABASE_URL=
PGHOST=<postgres-host>
PGPORT=5432
PGDATABASE=<postgres-database>
PGUSER=<postgres-user>
PGPASSWORD=<postgres-password>
PGSSL=true

# Login administrativo independiente (migraciones y jobs controlados). Completar
# ADMIN_DATABASE_URL O el bloque PGADMIN*, no ambos. Los valores los entrega el
# proveedor PostgreSQL/DBA; ver docs/runtime-rls-rollout.md.
# Debe poder asumir miclub_admin; nunca reutilizar estas credenciales en la API.
ADMIN_DATABASE_URL=
PGADMINHOST=<postgres-admin-host>
PGADMINPORT=5432
PGADMINDATABASE=<postgres-database>
PGADMINUSER=<postgres-admin-user>
PGADMINPASSWORD=<postgres-admin-password>
PGADMINSSL=true
# Opcional: rol propietario que el login admin debe asumir para ejecutar DDL.
# En instalaciones existentes suele ser el antiguo usuario de DATABASE_URL.
PGADMINROLE=

# -----------------------------------------------------------------------------
# OPCIONALES / AJUSTES DE RUNTIME
# -----------------------------------------------------------------------------
PORT=4000
VITE_API_URL=
PUBLIC_REGISTRATION_ENABLED=false
CORS_ORIGINS=
JSON_BODY_LIMIT=1mb
RATE_LIMIT_STORE=postgres
DEBUG_ENDPOINTS_ENABLED=false
DEBUG_DASHBOARD_RECONCILIATION=false

# -----------------------------------------------------------------------------
# TEMPORALES — SOLO DURANTE UNA IMPORTACIÓN O TAREA OPERATIVA CONTROLADA
# -----------------------------------------------------------------------------
IMPORT_ENDPOINTS_ENABLED=false
IMPORT_OPERATOR_USER=

BOOTSTRAP_DIRECTOR_ENABLED=false
BOOTSTRAP_DIRECTOR_PASSWORD=<definir-solo-en-el-proceso-bootstrap>
AUTH_NEW_PASSWORD=<definir-solo-al-rotar-una-clave>
CLUB_ID=<club-uuid-para-scripts-de-auditoria>

# -----------------------------------------------------------------------------
# LEGACY — NO USAR EN DESPLIEGUES NUEVOS
# Conservadas únicamente para migración/pruebas de compatibilidad.
# -----------------------------------------------------------------------------
SQLITE_DB_PATH=apps/api/data/miclub.sqlite

# STAGING: el endpoint XLSX debe permanecer deshabilitado fuera de una ventana
# controlada de importación.
# IMPORT_ENDPOINTS_ENABLED=false
