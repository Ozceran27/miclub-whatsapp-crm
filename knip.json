{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/index.ts", "src/scripts/*.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "!src/**/*.test.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [
    "apps/api/src/scripts/**",
    "apps/api/db/migrations/**",
    "apps/api/db/diagnostics/**",
    "apps/api/db/stabilization/**"
  ],
  "ignoreDependencies": ["@types/*"]
}
