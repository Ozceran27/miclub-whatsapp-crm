{
  "name": "miclub-whatsapp-crm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @miclub/api\" \"npm run dev -w @miclub/web\"",
    "build": "npm run build -w @miclub/shared && npm run build -w @miclub/api && npm run build -w @miclub/web",
    "typecheck": "npm run typecheck -ws",
    "start": "npm run start -w @miclub/api",
    "start:prod": "npm run build && npm run start",
    "check": "npm run lint -ws && npm run deadcode && npm run typecheck && npm run build && npm run test -ws --if-present",
    "import:sheets": "tsx apps/api/src/scripts/importGoogleSheetsToPostgres.ts",
    "import:sheets:dry": "tsx apps/api/src/scripts/importGoogleSheetsToPostgres.ts --dry-run",
    "audit:postgres": "tsx apps/api/src/scripts/auditPostgres.ts",
    "audit:economy-yearly-breakdown": "tsx apps/api/src/scripts/auditEconomyYearlyBreakdown.ts",
    "audit:economy-movements": "tsx apps/api/src/scripts/auditEconomyMovements.ts",
    "db:migrate": "tsx apps/api/src/scripts/runMigrations.ts",
    "db:migrations:check": "tsx --test apps/api/src/scripts/migrationManifest.test.ts",
    "bootstrap:director": "tsx apps/api/src/scripts/bootstrapDirector.ts",
    "auth:set-password": "npm run auth:set-password -w @miclub/api --",
    "lint": "eslint .",
    "deadcode": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "knip": "^5.70.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.3"
  }
}
